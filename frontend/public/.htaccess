# ==============================================================================
# Acecore cPanel / Apache Configuration
# ==============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ----------------------------------------------------------------------------
  # 1. API Endpoint Routing
  # ----------------------------------------------------------------------------
  # Route /api/contact -> /api/contact.php
  RewriteRule ^api/contact/?$ api/contact.php [L,QSA]

  # Route /api/pricing/:id -> /api/pricing.php?id=:id
  RewriteRule ^api/pricing/([a-zA-Z0-9_-]+)/?$ api/pricing.php?id=$1 [L,QSA]

  # Route /api/pricing -> /api/pricing.php
  RewriteRule ^api/pricing/?$ api/pricing.php [L,QSA]

  # Route /api/health -> return basic JSON directly or through pricing.php
  RewriteRule ^api/health/?$ api/pricing.php [L,QSA]

  # ----------------------------------------------------------------------------
  # 2. Canonical route redirects and direct public page loading
  # ----------------------------------------------------------------------------
  RewriteRule ^home/?$ / [R=301,L]
  RewriteRule ^contact/?$ /support [R=301,L]
  RewriteRule ^confirmation/?$ /order-confirmation [R=301,L]
  RewriteRule ^(product|pricing|about|team|support|terms|request-quote|checkout|order-confirmation)/$ /$1 [R=301,L]
  RewriteRule ^(product|pricing|about|team|support|terms|request-quote|checkout|order-confirmation)/?$ index.html [L]

  # ----------------------------------------------------------------------------
  # 3. Serve existing files; unknown paths remain genuine HTTP 404 responses
  # ----------------------------------------------------------------------------
  # If requested resource is an existing file or directory, serve it directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ - [R=404,L]
</IfModule>

ErrorDocument 404 /index.html

# ------------------------------------------------------------------------------
# 4. Security Headers
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Robots-Tag "noindex, nofollow" env=noindex_page
</IfModule>

<IfModule mod_setenvif.c>
  SetEnvIfNoCase Request_URI "^/(checkout|order-confirmation)/?$" noindex_page
</IfModule>

# ------------------------------------------------------------------------------
# 5. Gzip / Deflate Compression
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ------------------------------------------------------------------------------
# 6. Static Assets Caching
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>

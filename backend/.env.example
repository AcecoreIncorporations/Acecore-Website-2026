# ==============================================================================
# Acecore Backend Environment Configuration
# ==============================================================================
# Copy this file to .env:
#   cp .env.example .env
# Fill in your SMTP credentials to send live emails from the contact form.
# If these are left blank, the server runs in safe [SMTP PREVIEW MODE]
# (prints the inquiry to console without throwing errors).
# ==============================================================================

# Server Port (Default is 5001 to prevent macOS AirPlay port 5000 collision)
PORT=5001

# ------------------------------------------------------------------------------
# Email SMTP Configuration
# ------------------------------------------------------------------------------
# Destination email address that receives website inquiries:
CONTACT_TO_EMAIL=support@acecore.tech

# Sender email address (often the same as SMTP_USER):
CONTACT_FROM_EMAIL=support@acecore.tech

# SMTP Server Hostname
# Examples:
#   Gmail:           smtp.gmail.com
#   Brevo:           smtp-relay.brevo.com
#   SendGrid:        smtp.sendgrid.net
#   Hostinger/cPanel: mail.yourdomain.com
SMTP_HOST=

# SMTP Server Port
#   587 - Standard STARTTLS (recommended)
#   465 - SSL/TLS direct
#   25  - Plain text (usually blocked by cloud hosts)
SMTP_PORT=587

# Use SSL/TLS directly (set to true for port 465, false for port 587)
SMTP_SECURE=false

# SMTP Username / Login
# For Gmail: your full Gmail address (e.g., example@gmail.com)
# For Brevo/SendGrid: your account login or API key username
SMTP_USER=

# SMTP Password / App Password
# NOTE: For Gmail, do NOT use your account login password.
# Generate a 16-character App Password at https://myaccount.google.com/apppasswords
SMTP_PASS=
